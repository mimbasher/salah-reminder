<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything the self-updater needs, and nothing else needs. The Play build is the same app
  without this file: no internet, no installing of packages, no download receiver — because
  Play updates its own apps and its policy does not allow an app to install code itself.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <receiver android:name=".DownloadReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
