<?xml version="1.0" encoding="utf-8"?>
<!-- The screens are built in Java, so their views have no ids from a layout file. Android
     only saves and restores the state of a view that has one, and since a screen is rebuilt
     on every rotation and every fold, these keep the scroll position and the typed text. -->
<resources>
    <item name="scroll" type="id" />
    <item name="search" type="id" />
</resources>
