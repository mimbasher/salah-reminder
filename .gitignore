# Build output
build/
.gradle/
*.apk
*.ap_

# Local machine config (never commit: contains absolute SDK paths)
local.properties
.idea/
*.iml

# Local toolchain fetched by scripts/dev.sh
.toolchain/

# Gradle wrapper: unused here, and it would pin a third Gradle version.
# CI pins 8.9 via setup-gradle; scripts/dev.sh fetches its own 8.9 and a JDK 17.
gradlew
gradlew.bat
gradle/wrapper/

# Source audio dropped in the project root — the app's copy lives in res/raw/
/*.mp3
/*.wav
/*.m4a

# Signing material — must never be committed
keystore.jks
keystore.properties
